  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VillageVenueTaskGuide
  progressBoard: {fileID: 110213106}
  objectiveId: art
  venueTitle: ART STUDIO
  instructions:
  - Mount a blank canvas
  - Prepare paint on the palette
  - Switch on the studio lamp
  - Lay out a paint brush
  - Pin up the color swatch
  - Rotate the sculpture stand
  - Display the sculpture
  - Prepare the picture frame
